# Leave LLM_PROVIDER unset to auto-detect: a present ANTHROPIC_API_KEY selects
# the live provider, no key falls back to the scripted question bank. Set it to
# `scripted` to force demo mode even when a key is configured.
# LLM_PROVIDER=scripted

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GRADE_EFFORT=high
QUESTION_EFFORT=low
ENABLE_FALLBACKS=true

# Local development.
DATABASE_URL=sqlite+aiosqlite:///./mettle.db

# Supabase. Prefer the DIRECT connection on port 5432 (session mode).
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#
# The pooler on port 6543 is transaction mode and does NOT support prepared
# statements, which psycopg uses by default. PG_DISABLE_PREPARED_STATEMENTS is
# true by default so the pooler works, at a small performance cost; set it to
# false only on a direct/session-mode connection.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
PG_DISABLE_PREPARED_STATEMENTS=true
PG_POOL_MIN=1
PG_POOL_MAX=10

# Comma separated. Local origins are always allowed via regex for development.
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
