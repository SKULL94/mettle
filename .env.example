# Copy to .env and fill in. With no key set, the API falls back to the
# deterministic scripted provider, so the whole stack runs without credentials.

# Provider selection: "scripted" (no network) or "anthropic"
LLM_PROVIDER=scripted

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Local checkpoint + read-model store
DATABASE_URL=sqlite+aiosqlite:///./mettle.db

# Comma-separated origins allowed to call the API (Flutter web dev server, Pages origin)
CORS_ORIGINS=http://localhost:8080
