# A key is required. There is one provider and no offline mode: without a key
# the backend starts and serves /healthz and /v1/meta, but POST /v1/sessions
# returns 503. See docs/backend-plan.md "Why there is no scripted provider".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GRADE_EFFORT=high
QUESTION_EFFORT=low
ENABLE_FALLBACKS=true

# Local development.
DATABASE_URL=sqlite+aiosqlite:///./mettle.db

# Supabase. Prefer the DIRECT connection on port 5432 (session mode).
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#
# The pooler on port 6543 is transaction mode and does NOT support prepared
# statements, which psycopg uses by default. PG_DISABLE_PREPARED_STATEMENTS is
# true by default so the pooler works, at a small performance cost; set it to
# false only on a direct/session-mode connection.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
PG_DISABLE_PREPARED_STATEMENTS=true
PG_POOL_MIN=1
PG_POOL_MAX=10

# Supabase auth. Not read by the backend yet - these land with the JWT
# verification dependency (auth-plan.md §5, build-order step 3). Fill them in
# when you create the project so the values are in one place.
#
# SUPABASE_URL is the Project URL from Settings -> API Keys. Everything the
# verifier needs is derived from it:
#   issuer   ${SUPABASE_URL}/auth/v1
#   JWKS     ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
#   audience authenticated
SUPABASE_URL=

# The SECRET key (sb_secret_...), not the publishable one. It bypasses every RLS
# policy, so it is server-side only: never in the app, never in a dart-define.
# This is what the backend writes sessions and scores with.
SUPABASE_SECRET_KEY=

# The app's half of the Supabase config lives in app/dart_defines/local.json -
# the Project URL, the PUBLISHABLE key, and the Google client IDs. Those are
# safe in a client (RLS is what protects the data); the key above is not.

# Comma separated. Local origins are always allowed via regex for development.
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
